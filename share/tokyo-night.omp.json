{
  "$schema": "https://raw.githubusercontent.com/JanDeLaaj/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#bb9af7",
          "template": "👤{{ .UserName }}"
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#7dcfff",
          "template": "@"
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#f7768e",
          "template": "{{ .HostName }}"
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#7aa2f7",
          "properties": {
            "style": "full",
            "home_icon": "~",
            "folder_separator_icon": "/"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#9ece6a",
          "properties": {
            "fetch_status": true
          },
          "template": "{{ .HEAD }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#7aa2f7",
          "template": "❯❯ "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#7aa2f7",
    "template": "❯❯ "
  }
}